<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>dk.sdu.cbse</groupId><artifactId>asteroids-final</artifactId><version>1.0-SNAPSHOT</version></parent>
    <artifactId>asteroids-integration</artifactId>
    <dependencies>
        <dependency><groupId>dk.sdu.cbse</groupId><artifactId>dk.sdu.cbse.core</artifactId><version>${project.version}</version></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>gameplay-smoke-test</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <workingDirectory>${project.basedir}/..</workingDirectory>
                            <arguments><argument>--module-path</argument><modulepath/><argument>-m</argument><argument>dk.sdu.cbse.core/dk.sdu.cbse.core.GameplaySmokeTest</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>plugin-smoke-test</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <workingDirectory>${project.basedir}/..</workingDirectory>
                            <arguments><argument>--module-path</argument><modulepath/><argument>-m</argument><argument>dk.sdu.cbse.core/dk.sdu.cbse.core.PluginSmokeTest</argument></arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
